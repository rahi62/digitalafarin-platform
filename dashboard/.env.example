DATABASE_URL=postgresql://wp_agent:change-me@127.0.0.1:5432/wp_agent
# Generate with: printf '%s' 'your-password' | sha256sum
ADMIN_PASSWORD_SHA256=replace-with-64-character-sha256
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-random-session-secret
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google Search Console OAuth (read-only scope)
GSC_GOOGLE_CLIENT_ID=
GSC_GOOGLE_CLIENT_SECRET=
GSC_GOOGLE_REDIRECT_URI=https://wp-agent.digitalafarin.ir/api/gsc/oauth/callback
