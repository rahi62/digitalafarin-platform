[Unit]
Description=DigitalAfarin Agency MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/digitalafarin-agency-mcp
EnvironmentFile=/etc/digitalafarin-agency-mcp.env
ExecStart=/usr/bin/node /var/www/digitalafarin-agency-mcp/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/digitalafarin-agency-mcp/data

[Install]
WantedBy=multi-user.target
