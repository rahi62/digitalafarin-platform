HOST=127.0.0.1
PORT=3050
ALLOWED_ORIGINS=https://chatgpt.com
# Optional extra protection if your deployment path supports a bearer token.
BEARER_TOKEN=

# Legacy JSON store retained only during the PostgreSQL migration window.
DATA_FILE=./data/agency.json
STORE_DRIVER=json

# Agency Core database. Set in production before switching STORE_DRIVER=postgres.
DATABASE_URL=postgresql://digitalafarin_agency:change-me@127.0.0.1:5432/digitalafarin_agency

# Admin/auth defaults. Do not commit real production secrets.
SESSION_COOKIE_NAME=digitalafarin_agency_session
SESSION_TTL_HOURS=168
ADMIN_ORIGIN=https://agency.digitalafarin.ir
CSRF_SECRET=replace-with-a-long-random-production-secret
