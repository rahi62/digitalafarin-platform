[Unit]
Description=DigitalAfarin WP Agent Dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/digitalafarin-wordpress-mcp/dashboard
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/digitalafarin-wp-agent.env
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3040
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/digitalafarin-wordpress-mcp/dashboard/.next

[Install]
WantedBy=multi-user.target
