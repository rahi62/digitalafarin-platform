# Shared local development defaults
PLATFORM_AGENT_TOKEN=change-me-agent-token
PLATFORM_API_TOKEN=change-me-api-token
PLATFORM_API_URL=http://127.0.0.1:8000
PLATFORM_SERVER_ID=1

# Agent
AGENT_BIND_HOST=127.0.0.1
AGENT_BIND_PORT=9743
AGENT_SERVICE_PREFIXES=digitalafarin-,khoshvisa-,oily-

# Django
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
