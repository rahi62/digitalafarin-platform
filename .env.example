# Shared local development defaults / legacy compatibility
PLATFORM_API_TOKEN=replace-me
PLATFORM_AGENT_TOKEN=replace-me
PLATFORM_API_URL=http://127.0.0.1:8000
PLATFORM_SERVER_ID=1

# Agent local read-only API
AGENT_BIND_HOST=127.0.0.1
AGENT_BIND_PORT=9743

# Agent outbound mode
PLATFORM_CONTROL_URL=https://panel.example.com
PLATFORM_ENROLLMENT_TOKEN=one-time-value-only-during-first-enrollment
AGENT_TOKEN_PATH=/var/lib/digitalafarin-agent/agent.token
AGENT_HEARTBEAT_INTERVAL_SECONDS=15
AGENT_NAME=DigitalAfarin-Primary
AGENT_SERVICE_PREFIXES=digitalafarin-,oily-,khoshvisa-

# Django
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TELEGRAM_CREDENTIAL_ENCRYPTION_KEY=replace-me-with-fernet-key

# Existing VPS MCP -> Django
CONTROL_PLANE_URL=http://127.0.0.1:8000
CONTROL_PLANE_TOKEN=replace-me-with-service-principal-token
MCP_HOST=127.0.0.1
MCP_PORT=3060
MCP_PATH=/mcp

# Telegram admin web -> Django (dedicated telegram-admin service principal)
TELEGRAM_PLATFORM_API_TOKEN=replace-me-with-telegram-admin-service-principal-token

# Dedicated Telegram MCP -> Django (dedicated telegram-mcp service principal)
TELEGRAM_MCP_HOST=127.0.0.1
TELEGRAM_MCP_PORT=3061
TELEGRAM_MCP_PATH=/mcp
# Telegram MCP also consumes CONTROL_PLANE_URL + its own CONTROL_PLANE_TOKEN in telegram-mcp.env

# Coolify provider (server-side only; never commit a real token)
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=replace-me-with-read-only-coolify-token
# Optional typed management: empty means disabled. See docs/coolify-management.md.
# Real write/deploy credentials stay exclusively in the Django service environment.
COOLIFY_MANAGEMENT_TARGETS={}
